    "packages/compile/package.json",
    "packages/compile/src",
    "packages/deliver/package.json",
    "packages/deliver/src",
    "packages/mcp/package.json",
    "packages/mcp/src",
    "packages/embed/package.json",
    "packages/embed/src",
    "packages/import/node",
    "packages/import/package.json",
    "packages/import/src",
    "packages/retrieve/package.json",
    "packages/retrieve/src"
  ],
  "scripts": {
    "test": "node --test \"packages/*/tests/*.test.js\" \"apps/*/tests/*.test.js\""
